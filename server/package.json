    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "file-type": "^22.0.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
