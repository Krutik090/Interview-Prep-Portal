<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<style>
  body { font-family: Arial, Helvetica, sans-serif; color: #1a1a1a; margin: 40px; }
  h1 { margin: 0 0 4px; font-size: 26px; }
  .subtitle { color: #555; margin: 0 0 20px; font-size: 14px; }
  h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #ccc; padding-bottom: 4px; margin-top: 24px; }
  p { font-size: 13px; line-height: 1.5; }
  ul { font-size: 13px; line-height: 1.5; padding-left: 18px; }
  .tags span { display: inline-block; background: #f0f0f0; border-radius: 4px; padding: 2px 8px; margin: 0 4px 4px 0; font-size: 12px; }
</style>
</head>
<body>
  <h1><%= profile.fullName || 'Candidate' %></h1>
  <p class="subtitle"><%= profile.targetRole || '' %><% if (profile.education?.institution) { %> · <%= profile.education.institution %><% } %></p>

  <h2>Summary</h2>
  <p><%= aiContent.summary %></p>

  <% if (aiContent.skillsSection?.length) { %>
    <h2>Skills</h2>
    <div class="tags"><% aiContent.skillsSection.forEach(function(skill) { %><span><%= skill %></span><% }) %></div>
  <% } %>

  <% if (aiContent.projectsSection?.length) { %>
    <h2>Projects / Experience</h2>
    <ul><% aiContent.projectsSection.forEach(function(item) { %><li><%= item %></li><% }) %></ul>
  <% } %>

  <% if (aiContent.achievementsSection?.length) { %>
    <h2>Achievements</h2>
    <ul><% aiContent.achievementsSection.forEach(function(item) { %><li><%= item %></li><% }) %></ul>
  <% } %>

  <% if (completedPrograms?.length) { %>
    <h2>Interview Preparation Completed</h2>
    <ul>
      <% completedPrograms.forEach(function(p) { %>
        <li><%= p.title %> (<%= p.roundType %>) — <%= p.scorePct %>%</li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>
