NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/interview_prep
REDIS_URL=redis://127.0.0.1:6379

# Generate strong random values for these, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

GEMINI_API_KEY=changeme_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Local disk storage root (relative to server/)
STORAGE_ROOT=storage

# Only read by `npm run seed:admin` (creates the first admin account).
# Set them just for that run, or remove them from .env afterwards.
# ADMIN_EMAIL=placement.cell@your-college.edu
# ADMIN_PASSWORD=
